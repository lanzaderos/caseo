# Copia este fichero a .env y rellena los valores.

# Dominio público donde se servirá Caseo (sin https://).
PHX_HOST=caseo.example.com

# Genera con: openssl rand -base64 48
SECRET_KEY_BASE=

# Contraseña de PostgreSQL. Genera con: openssl rand -hex 24
POSTGRES_PASSWORD=

# Token compartido entre core y el sidecar de WhatsApp. Genera con: openssl rand -hex 32
WHATSMEOW_TOKEN=

# Versión de las imágenes (tag de ghcr.io). "latest" sigue la última publicada.
CASEO_VERSION=latest

# Dónde escucha core en el host. Por defecto solo en local, para ponerlo detrás de un proxy inverso con HTTPS.
CASEO_BIND=127.0.0.1
CASEO_PORT=4000

# URL a la que el sidecar reenvía los mensajes entrantes. Vacío = no se reenvían.
WHATSMEOW_WEBHOOK_URL=
