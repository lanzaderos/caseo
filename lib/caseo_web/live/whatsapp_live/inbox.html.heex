<Layouts.app flash={@flash} current_scope={@current_scope} section={:whatsapp}>
  <section lang="es" class="space-y-4">
    <header class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <h1 class="workspace-title">WhatsApp</h1>
        <p class="workspace-muted mt-1 text-sm">
          <%= if Account.linked?(@account) do %>
            Conversaciones de <span class="tabular-nums">{@account.phone}</span>.
          <% else %>
            Vincula tu número para recibir y responder mensajes aquí.
          <% end %>
        </p>
      </div>
      <.link
        id="whatsapp-settings"
        navigate={~p"/whatsapp/vincular"}
        class={[
          "btn min-h-11 rounded-xl",
          if(Account.linked?(@account),
            do: "btn-ghost workspace-glass",
            else: "workspace-primary"
          )
        ]}
      >
        <.icon name="hero-qr-code" class="size-4" />
        {if(Account.linked?(@account), do: "Número", else: "Vincular número")}
      </.link>
    </header>

    <div class="workspace-glass grid min-h-[34rem] overflow-hidden rounded-2xl lg:grid-cols-[17rem_minmax(0,1fr)_17rem]">
      <%!-- Conversations --%>
      <nav
        id="conversations"
        aria-label="Conversaciones"
        class={[
          "workspace-divider max-h-[70vh] overflow-y-auto border-b lg:max-h-none lg:border-e lg:border-b-0",
          @phone && "hidden lg:block"
        ]}
      >
        <p :if={@conversations == []} id="conversations-empty" class="workspace-muted p-6 text-sm">
          Todavía no hay conversaciones. Los mensajes que recibas aparecerán aquí.
        </p>
        <ul role="list">
          <li :for={conversation <- @conversations}>
            <.link
              id={"conversation-#{digits(conversation.contact_phone)}"}
              patch={~p"/whatsapp/#{digits(conversation.contact_phone)}"}
              aria-current={if(conversation.contact_phone == @phone, do: "page")}
              class="workspace-divider flex items-start gap-3 border-b px-4 py-3 transition hover:bg-base-content/5 aria-[current=page]:bg-base-content/10"
            >
              <span class="workspace-marker grid size-9 shrink-0 place-items-center rounded-full">
                <.icon name="hero-user" class="size-4" />
              </span>
              <span class="min-w-0 flex-1">
                <span class="flex items-baseline justify-between gap-2">
                  <span class="truncate text-sm font-semibold">{title(conversation)}</span>
                  <time
                    id={"conversation-time-#{conversation.last_message.id}"}
                    datetime={DateTime.to_iso8601(conversation.last_message.sent_at)}
                    phx-hook="LocalTime"
                    phx-update="ignore"
                    class="workspace-muted shrink-0 text-xs tabular-nums"
                  >
                    {Calendar.strftime(conversation.last_message.sent_at, "%H:%M")}
                  </time>
                </span>
                <span class="flex items-center justify-between gap-2">
                  <span class="workspace-muted truncate text-sm">
                    <span :if={conversation.last_message.direction == :outbound}>Tú: </span>{Message.preview(
                      conversation.last_message
                    )}
                  </span>
                  <span
                    :if={conversation.unread > 0}
                    id={"unread-#{digits(conversation.contact_phone)}"}
                    class="badge badge-success badge-sm shrink-0"
                    aria-label={"#{conversation.unread} sin leer"}
                  >
                    {conversation.unread}
                  </span>
                </span>
              </span>
            </.link>
          </li>
        </ul>
      </nav>

      <%= if @phone do %>
        <%!-- Chat --%>
        <section
          id="chat"
          class="flex min-h-[34rem] min-w-0 flex-col"
          aria-labelledby="chat-title"
        >
          <header class="workspace-divider flex items-center gap-3 border-b px-4 py-3">
            <.link
              patch={~p"/whatsapp"}
              class="btn btn-ghost btn-sm btn-square lg:hidden"
              aria-label="Volver a las conversaciones"
            >
              <.icon name="hero-arrow-left" class="size-4" />
            </.link>
            <div class="min-w-0">
              <h2 id="chat-title" class="truncate font-semibold">
                {chat_title(@lead, @conversations, @phone)}
              </h2>
              <p class="workspace-muted text-xs tabular-nums">{@phone}</p>
            </div>
          </header>

          <ol
            id="messages"
            phx-update="stream"
            phx-hook="ScrollBottom"
            class="flex max-h-[55vh] flex-1 flex-col gap-2 overflow-y-auto p-4"
          >
            <li id="messages-empty" class="workspace-muted hidden text-center text-sm only:block">
              No hay mensajes con este contacto.
            </li>
            <li
              :for={{id, message} <- @streams.messages}
              id={id}
              class={[
                "max-w-[80%] rounded-2xl px-3 py-2 text-sm shadow-sm",
                if(message.direction == :outbound,
                  do: "self-end rounded-br-sm bg-success/20",
                  else: "self-start rounded-bl-sm bg-base-100/80"
                )
              ]}
            >
              <p class={[
                "whitespace-pre-wrap [overflow-wrap:anywhere]",
                is_nil(message.body) && "workspace-muted italic"
              ]}>
                {Message.preview(message)}
              </p>
              <time
                id={"message-time-#{message.id}"}
                datetime={DateTime.to_iso8601(message.sent_at)}
                phx-hook="LocalTime"
                phx-update="ignore"
                class="workspace-muted mt-0.5 block text-end text-[0.7rem] tabular-nums"
              >
                {Calendar.strftime(message.sent_at, "%H:%M")}
              </time>
            </li>
          </ol>

          <.form
            for={@message_form}
            id="message-form"
            phx-submit="send"
            class="workspace-divider flex items-end gap-2 border-t p-3"
          >
            <div class="flex-1 [&_.fieldset]:mb-0">
              <.input
                field={@message_form[:body]}
                id="message-body"
                type="textarea"
                rows="1"
                aria-label="Mensaje"
                placeholder={
                  if(Account.linked?(@account),
                    do: "Escribe un mensaje",
                    else: "Vincula tu número para responder"
                  )
                }
                disabled={!Account.linked?(@account)}
                class="textarea min-h-11 w-full resize-none"
              />
            </div>
            <button
              id="send-message"
              type="submit"
              disabled={!Account.linked?(@account)}
              phx-disable-with="…"
              class="btn workspace-primary btn-square min-h-11 rounded-xl"
              aria-label="Enviar"
            >
              <.icon name="hero-paper-airplane" class="size-5" />
            </button>
          </.form>
        </section>

        <%!-- Lead panel --%>
        <aside
          id="lead-panel"
          aria-label="Interesado"
          class="workspace-divider space-y-4 border-t p-4 lg:border-s lg:border-t-0"
        >
          <%= if @lead do %>
            <div>
              <.link
                id="panel-lead-link"
                navigate={~p"/interesados/#{@lead.id}"}
                class="font-semibold hover:underline"
              >
                {@lead.name}
              </.link>
              <p class="workspace-muted text-xs">Ficha del interesado</p>
            </div>

            <div
              :if={@suggestion && !already_linked?(@lead, @suggestion)}
              id="listing-suggestion"
              class="workspace-divider space-y-2 rounded-xl border p-3 text-sm"
            >
              <p>
                Ha enviado el anuncio de <strong>{suggestion_label(@suggestion)}</strong>.
              </p>
              <button
                id="link-suggested"
                type="button"
                phx-click="link_suggested"
                class="btn btn-sm workspace-primary rounded-lg"
              >
                Vincular este inmueble
              </button>
            </div>

            <ul id="panel-interests" class="space-y-2">
              <li
                :for={interest <- @lead.interests}
                id={"panel-interest-#{interest.id}"}
                class="workspace-divider space-y-1 rounded-xl border p-3 text-sm"
              >
                <p class="font-medium">{place(interest)}</p>
                <p class="workspace-muted text-xs">
                  {Interest.status_label(interest.status)}
                  <span :if={Interest.checklist_label(interest)}>
                    · {Interest.checklist_label(interest)}
                  </span>
                </p>
                <button
                  id={"panel-schedule-#{interest.id}"}
                  type="button"
                  phx-click="open_schedule"
                  phx-value-id={interest.id}
                  class="btn btn-sm btn-ghost -ms-2"
                >
                  <.icon name="hero-calendar-days" class="size-4" /> Agendar visita
                </button>
              </li>
            </ul>

            <.form
              :if={@target_options != []}
              for={@link_form}
              id="panel-link-form"
              phx-submit="link"
              class="space-y-2"
            >
              <.input
                field={@link_form[:target]}
                type="select"
                label="Vincular otro inmueble"
                prompt="Elige un inmueble"
                options={@target_options}
              />
              <button type="submit" class="btn btn-sm btn-ghost workspace-glass rounded-lg">
                <.icon name="hero-link" class="size-4" /> Vincular
              </button>
            </.form>

            <div :if={@visits != []} id="panel-visits">
              <h3 class="mb-1 text-sm font-semibold">Próximas visitas</h3>
              <ul class="space-y-1 text-sm">
                <li :for={visit <- @visits}>
                  <.link navigate={~p"/visitas/#{visit.id}"} class="hover:underline">
                    {Calendar.strftime(visit.starts_at, "%d/%m %H:%M")}
                  </.link>
                  <span class="workspace-muted">· {place(visit.interest)}</span>
                </li>
              </ul>
            </div>
          <% else %>
            <div id="panel-new-lead" class="space-y-3">
              <p class="text-sm">Este contacto todavía no es un interesado.</p>
              <p :if={@suggestion} id="listing-suggestion" class="text-sm">
                Ha enviado el anuncio de <strong>{suggestion_label(@suggestion)}</strong>.
              </p>
              <.form for={@lead_form} id="create-lead-form" phx-submit="create_lead">
                <.input field={@lead_form[:name]} label="Nombre" required />
                <button type="submit" class="btn btn-sm workspace-primary rounded-lg">
                  <.icon name="hero-user-plus" class="size-4" /> Crear interesado
                </button>
              </.form>
            </div>
          <% end %>
        </aside>
      <% else %>
        <div class="workspace-muted hidden place-items-center p-6 text-sm lg:col-span-2 lg:grid">
          Elige una conversación.
        </div>
      <% end %>
    </div>
  </section>

  <.live_component
    :if={@schedule}
    module={CaseoWeb.ScheduleVisitComponent}
    id="schedule-modal"
    current_scope={@current_scope}
    lead={@lead}
    interest={@schedule}
    whatsapp_linked={Account.linked?(@account)}
  />
</Layouts.app>
