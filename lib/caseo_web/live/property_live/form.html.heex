<Layouts.app flash={@flash} current_scope={@current_scope} section={:properties}>
  <section
    lang="es"
    aria-labelledby="property-form-title"
    class="space-y-6 sm:space-y-8"
  >
    <header>
      <h1 id="property-form-title" class="workspace-title">
        {@page_title}
      </h1>
    </header>
    <section
      :if={@live_action == :import}
      id="listing-import"
      aria-labelledby="listing-import-title"
      class="workspace-glass space-y-4 rounded-2xl px-5 py-5 sm:px-8"
    >
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="space-y-1">
          <h2 id="listing-import-title" class="text-lg font-semibold">Anuncio de Idealista</h2>
          <p class="workspace-muted text-sm">
            Revisa los datos leídos del anuncio, corrige lo necesario y completa lo que falte.
            Se guardará como borrador.
          </p>
          <a
            id="listing-import-source"
            href={@listing_import.url}
            target="_blank"
            rel="noreferrer"
            class="link text-sm break-all"
          >
            {@listing_import.url}
          </a>
        </div>
        <button
          id="discard-import"
          type="button"
          phx-click="discard"
          class="btn btn-ghost min-h-11 rounded-xl"
        >
          Descartar
        </button>
      </div>

      <div
        :if={@matches.properties != [] or @matches.rooms != []}
        id="listing-import-matches"
        role="alert"
        class="alert alert-warning alert-soft text-sm"
      >
        <div class="space-y-1">
          <p class="font-medium">Ya usaste este anuncio:</p>
          <ul class="list-disc ps-5">
            <li :for={property <- @matches.properties}>
              <.link navigate={~p"/inmuebles/#{property.id}"} class="link">{property.name}</.link>
            </li>
            <li :for={room <- @matches.rooms}>
              <.link navigate={~p"/inmuebles/#{room.property.id}"} class="link">
                {room.property.name} · {room.name}
              </.link>
            </li>
          </ul>
          <p>
            Si creas otro inmueble, el anuncio seguirá vinculado al anterior.
            También puedes vincularlo a otro registro.
          </p>
        </div>
      </div>

      <form
        :if={@link_targets != []}
        id="listing-import-link"
        phx-submit="link"
        class="flex flex-wrap items-end gap-2"
      >
        <label class="grow space-y-1 text-sm">
          <span class="font-medium">Vincular a un inmueble o habitación existente</span>
          <select name="target" class="select w-full" required>
            <option value="">Elige…</option>
            <%= for property <- @link_targets do %>
              <option value={"property:#{property.id}"}>{property.name}</option>
              <option :for={room <- property.rooms} value={"room:#{room.id}"}>
                {property.name} · {room.name}
              </option>
            <% end %>
          </select>
        </label>
        <button id="link-import" type="submit" class="btn btn-ghost min-h-11 rounded-xl">
          Vincular
        </button>
      </form>
    </section>
    <.form
      for={@form}
      id="property-form"
      phx-change="validate"
      phx-submit="save"
      class="workspace-glass overflow-hidden rounded-2xl"
    >
      <div class="grid gap-4 px-5 py-6 sm:grid-cols-2 sm:px-8 sm:py-8">
        <div class="sm:col-span-2">
          <.input field={@form[:name]} label="Nombre del inmueble" required maxlength="255" />
        </div>
        <.input
          field={@form[:mode]}
          type="select"
          label="Modalidad"
          options={[
            {"Alquiler de vivienda completa", :rental},
            {"Alquiler por habitaciones", :rooms},
            {"Venta", :sale}
          ]}
        />
        <section
          class="sm:col-span-2 workspace-divider space-y-4 border-t pt-4"
          aria-labelledby="property-address-title"
        >
          <h2 id="property-address-title" class="text-lg font-semibold">Dirección</h2>
          <div
            id="property-address-search"
            phx-hook="PropertyAddress"
            phx-update="ignore"
            data-search-url={~p"/inmuebles/direcciones"}
            class="space-y-3"
          >
            <label for="property-address-query" class="text-sm font-medium">
              Buscar dirección
            </label>
            <div data-address-autocomplete></div>
            <p class="workspace-muted text-xs">
              Busca por calle, número y municipio en España. Datos del IGN · CartoCiudad.
            </p>
            <p data-address-status role="status" class="workspace-muted text-sm" hidden></p>
            <div
              data-address-map
              aria-label="Mapa de la dirección seleccionada"
              role="region"
              class="property-address-map workspace-divider h-56 w-full rounded-xl border"
              hidden
            >
            </div>
          </div>
          <input
            type="hidden"
            name={@form[:latitude].name}
            id={@form[:latitude].id}
            value={@form[:latitude].value}
          />
          <input
            type="hidden"
            name={@form[:longitude].name}
            id={@form[:longitude].id}
            value={@form[:longitude].value}
          />
          <details
            id="property-address-fields"
            open={address_errors?(@form)}
            class="workspace-divider rounded-xl border px-4 py-3"
          >
            <summary class="cursor-pointer text-sm font-medium focus-visible:outline-2 focus-visible:outline-offset-4">
              Introducir o corregir dirección
              <span :if={@form[:street].value} class="workspace-muted block pt-1 font-normal">
                {@form[:street].value}
                <span :if={@form[:municipality].value}>· {@form[:municipality].value}</span>
              </span>
            </summary>
            <div class="mt-4 grid gap-4 sm:grid-cols-2">
              <div class="sm:col-span-2">
                <.input field={@form[:street]} label="Vía y número" maxlength="255" />
              </div>
              <.input field={@form[:municipality]} label="Municipio" maxlength="255" />
              <.input
                field={@form[:postal_code]}
                label="Código postal"
                maxlength="255"
                autocomplete="postal-code"
              />
              <.input field={@form[:province]} label="Provincia" maxlength="255" />
              <p
                :for={error <- @form[:latitude].errors ++ @form[:longitude].errors}
                class="sm:col-span-2 text-error text-sm"
              >
                {translate_error(error)}
              </p>
            </div>
          </details>
          <div class="grid gap-4 sm:grid-cols-2">
            <.input field={@form[:floor]} label="Piso (opcional)" maxlength="255" />
            <.input field={@form[:door]} label="Puerta (opcional)" maxlength="255" />
          </div>
        </section>
        <div class="sm:col-span-2 workspace-divider border-t pt-4">
          <h2 class="text-lg font-semibold">Descripción y servicios</h2>
        </div>
        <div class="sm:col-span-2">
          <.input
            field={@form[:description]}
            type="textarea"
            label="Descripción"
            maxlength="10000"
          />
          <.input
            field={@form[:amenities]}
            type="textarea"
            label="Servicios y características"
            maxlength="5000"
          />
          <.input
            field={@form[:source_url]}
            type="url"
            label="Enlace de Idealista (opcional)"
            maxlength="2048"
          />
          <p class="workspace-muted text-sm">
            Puedes pegar el enlace del anuncio y copiar sus datos en este formulario.
          </p>
        </div>
        <%= cond do %>
          <% @form[:mode].value in [:rooms, "rooms"] -> %>
            <fieldset
              id="property-rooms"
              class="sm:col-span-2 workspace-divider space-y-4 border-t pt-4"
            >
              <legend class="text-lg font-semibold">Habitaciones</legend>
              <p :for={error <- @form[:rooms].errors} class="text-error text-sm">
                {translate_error(error)}
              </p>
              <.inputs_for :let={room} field={@form[:rooms]}>
                <fieldset class="workspace-divider grid gap-4 rounded-xl border p-4 sm:grid-cols-2">
                  <legend class="px-2 font-semibold">Habitación {room.index + 1}</legend>
                  <input type="hidden" name="property[rooms_sort][]" value={room.index} />
                  <div class="sm:col-span-2">
                    <.input field={room[:name]} label="Nombre de la habitación" maxlength="255" />
                    <.input
                      field={room[:description]}
                      type="textarea"
                      label="Descripción de la habitación"
                      maxlength="5000"
                    />
                  </div>
                  <.rental_fields form={room} />
                  <div class="sm:col-span-2 flex flex-wrap items-center gap-2">
                    <.link
                      :if={room.data.id}
                      navigate={~p"/inmuebles/#{@property.id}/habitaciones/#{room.data.id}/fotos"}
                      class="btn btn-ghost"
                    >
                      Fotos de la habitación
                    </.link>
                    <button
                      id={"remove-room-#{room.index}"}
                      type="button"
                      name="property[rooms_drop][]"
                      value={room.index}
                      phx-click={JS.dispatch("change")}
                      class="btn btn-ghost text-error"
                    >
                      Quitar habitación
                    </button>
                  </div>
                </fieldset>
              </.inputs_for>
              <input type="hidden" name="property[rooms_drop][]" />
              <button
                id="add-room"
                type="button"
                name="property[rooms_sort][]"
                value="new"
                phx-click={JS.dispatch("change")}
                class="btn btn-ghost"
              >
                <.icon name="hero-plus" class="size-4" /> Añadir habitación
              </button>
            </fieldset>
          <% @form[:mode].value in [:sale, "sale"] -> %>
            <.input
              field={@form[:sale_price]}
              label="Precio total (€)"
              inputmode="decimal"
              required
            />
            <.input field={@form[:available_on]} type="date" label="Disponible desde (opcional)" />
          <% true -> %>
            <.rental_fields form={@form} />
        <% end %>
      </div>
      <fieldset
        :if={@live_action == :import and @images != []}
        id="listing-import-images"
        class="workspace-divider space-y-4 border-t px-5 py-6 sm:px-8"
      >
        <legend class="text-lg font-semibold">Fotos del anuncio</legend>
        <p class="workspace-muted text-sm">
          Elige qué fotos incorporar a la galería (máximo 12).
        </p>
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
          <label
            :for={{url, index} <- Enum.with_index(@images)}
            class="workspace-divider relative cursor-pointer overflow-hidden rounded-xl border"
          >
            <img
              src={url}
              alt={"Foto #{index + 1} del anuncio"}
              loading="lazy"
              referrerpolicy="no-referrer"
              class="aspect-[4/3] w-full object-cover"
            />
            <input
              id={"listing-image-#{index}"}
              type="checkbox"
              name="images[]"
              value={url}
              checked={url in @selected_images}
              class="checkbox checkbox-sm absolute top-2 left-2 bg-base-100"
            />
          </label>
        </div>
        <label class="flex items-start gap-2 text-sm">
          <input
            id="reuse-authorized"
            type="checkbox"
            name="reuse_authorized"
            value="true"
            checked={@reuse_authorized}
            class="checkbox checkbox-sm mt-0.5"
          />
          <span>
            Confirmo que tengo derecho a reutilizar las fotos marcadas, por ejemplo porque el anuncio es mío.
          </span>
        </label>
        <p :if={@images_error} id="images-error" class="text-error text-sm">{@images_error}</p>
      </fieldset>
      <div class="workspace-divider flex flex-wrap items-center justify-end gap-2 border-t px-5 py-4 sm:px-8">
        <.link
          :if={@property.id}
          navigate={~p"/inmuebles/#{@property.id}"}
          class="btn btn-ghost me-auto"
        >
          Ver ficha y fotos
        </.link>
        <p
          :if={is_nil(@property.id) and @live_action != :import}
          class="workspace-muted me-auto text-sm"
        >
          Podrás añadir fotos desde la ficha después de guardar.
        </p>
        <.link
          id="cancel-property"
          navigate={@return_path}
          class="btn btn-ghost min-h-11 rounded-xl"
        >
          Cancelar
        </.link>
        <button
          id="save-property"
          type="submit"
          class="btn workspace-primary min-h-11 rounded-xl px-4"
          phx-disable-with="Guardando…"
        >
          {if @live_action == :import, do: "Crear borrador", else: "Guardar inmueble"}
        </button>
      </div>
    </.form>
  </section>
</Layouts.app>
