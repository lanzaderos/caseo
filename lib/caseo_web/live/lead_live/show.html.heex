<Layouts.app flash={@flash} current_scope={@current_scope} section={:leads}>
  <section lang="es" class="space-y-6">
    <header class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <.link navigate={~p"/interesados"} class="workspace-muted text-sm hover:underline">
          <.icon name="hero-arrow-left" class="size-4" /> Interesados
        </.link>
        <h1 id="lead-title" class="workspace-title mt-2">{@lead.name}</h1>
        <p class="workspace-muted text-sm tabular-nums">
          {@lead.phone} · {Lead.source_label(@lead.source)}
        </p>
      </div>
      <button
        id="delete-lead"
        type="button"
        phx-click="delete"
        data-confirm="¿Eliminar este interesado y sus vínculos con inmuebles?"
        class="btn btn-ghost text-error min-h-11 rounded-xl"
      >
        <.icon name="hero-trash" class="size-4" /> Eliminar
      </button>
    </header>

    <section class="workspace-glass rounded-2xl p-5 sm:p-8" aria-labelledby="interests-title">
      <h2 id="interests-title" class="mb-4 text-lg font-semibold">Inmuebles</h2>

      <ul id="lead-interests" phx-update="stream" class="space-y-3">
        <li id="lead-interests-empty" class="workspace-muted hidden text-sm only:block">
          Todavía no está vinculado a ningún inmueble.
        </li>
        <li
          :for={{id, item} <- @streams.interests}
          id={id}
          class="workspace-divider rounded-xl border p-4"
        >
          <div class="flex flex-wrap items-center justify-between gap-2">
            <.link
              navigate={~p"/inmuebles/#{item.interest.property_id}"}
              class="font-semibold hover:underline"
            >
              {place(item.interest)}
            </.link>
            <button
              id={"schedule-visit-#{item.id}"}
              type="button"
              phx-click="open_schedule"
              phx-value-id={item.id}
              class="btn btn-sm btn-ghost ms-auto"
            >
              <.icon name="hero-calendar-days" class="size-4" /> Agendar visita
            </button>
            <button
              id={"unlink-#{item.id}"}
              type="button"
              phx-click="unlink"
              phx-value-id={item.id}
              data-confirm="¿Desvincular este inmueble?"
              class="btn btn-sm btn-ghost workspace-muted"
            >
              Desvincular
            </button>
          </div>
          <.form
            for={item.form}
            id={"interest-form-#{item.id}"}
            phx-change="validate_interest"
            phx-submit="save_interest"
            class="mt-2 grid items-end gap-x-3 sm:grid-cols-[minmax(0,14rem)_minmax(0,1fr)_auto]"
          >
            <input type="hidden" name="interest_id" value={item.id} />
            <.input
              field={item.form[:status]}
              type="select"
              label="Estado"
              options={Interest.status_options()}
            />
            <div>
              <.input
                :if={item.form[:status].value in [:discarded, "discarded"]}
                field={item.form[:discard_reason]}
                label="Motivo del descarte"
              />
            </div>
            <div class="mb-2">
              <button type="submit" class="btn workspace-primary min-h-10 rounded-lg">
                Guardar
              </button>
            </div>
            <fieldset
              :if={Interest.checklist(item.interest) != []}
              id={"interest-checks-#{item.id}"}
              class="sm:col-span-3 mt-2"
            >
              <legend class="mb-2 text-sm font-semibold">
                Requisitos · {Interest.checklist_label(item.interest)}
              </legend>
              <div class="grid gap-x-4 gap-y-1 sm:grid-cols-2">
                <label
                  :for={{key, label, outcome} <- Interest.checklist(item.interest)}
                  class="flex items-center justify-between gap-3 text-sm"
                >
                  <span class="min-w-0 [overflow-wrap:anywhere]">{label}</span>
                  <select
                    id={"interest-#{item.id}-check-#{key}"}
                    name={"interest[checks][#{key}]"}
                    class="select select-sm w-32 shrink-0"
                  >
                    {Phoenix.HTML.Form.options_for_select(
                      Interest.check_options(),
                      check_value(item.form, key, outcome)
                    )}
                  </select>
                </label>
              </div>
            </fieldset>
          </.form>
        </li>
      </ul>

      <.form
        :if={@target_options != []}
        for={@link_form}
        id="link-form"
        phx-submit="link"
        class="mt-5 flex flex-wrap items-end gap-3"
      >
        <div class="min-w-56 flex-1">
          <.input
            field={@link_form[:target]}
            type="select"
            label="Vincular a un inmueble o habitación"
            prompt="Elige un inmueble"
            options={@target_options}
          />
        </div>
        <div class="mb-2">
          <button type="submit" class="btn btn-ghost workspace-glass min-h-10 rounded-lg">
            <.icon name="hero-link" class="size-4" /> Vincular
          </button>
        </div>
      </.form>
    </section>

    <section
      :if={@visits != []}
      id="lead-visits"
      class="workspace-glass rounded-2xl p-5 sm:p-8"
    >
      <h2 class="mb-3 text-lg font-semibold">Próximas visitas</h2>
      <ul class="space-y-1 text-sm">
        <li :for={visit <- @visits} id={"lead-visit-#{visit.id}"}>
          <.link navigate={~p"/visitas/#{visit.id}"} class="font-medium hover:underline">
            {Calendar.strftime(visit.starts_at, "%d/%m/%Y %H:%M")}
          </.link>
          · {place(visit.interest)}
          <span class="workspace-muted">
            · {Caseo.Visits.Visit.status_label(visit.status)}
          </span>
        </li>
      </ul>
    </section>

    <div class="workspace-glass rounded-2xl p-5 sm:p-8">
      <h2 class="mb-4 text-lg font-semibold">Datos de contacto</h2>
      <.form
        for={@form}
        id="lead-form"
        phx-change="validate"
        phx-submit="save"
        class="grid gap-x-4 sm:grid-cols-2"
      >
        <.input field={@form[:name]} label="Nombre" required />
        <.input field={@form[:phone]} type="tel" label="Teléfono" required />
        <.input field={@form[:email]} type="email" label="Email (opcional)" />
        <.input
          field={@form[:source]}
          type="select"
          label="Origen"
          options={Lead.source_options()}
        />
        <div class="sm:col-span-2">
          <.input field={@form[:notes]} type="textarea" label="Notas" />
        </div>
        <div class="sm:col-span-2">
          <button type="submit" class="btn workspace-primary min-h-11 rounded-xl px-4">
            Guardar cambios
          </button>
        </div>
      </.form>
    </div>
  </section>

  <div
    :if={@schedule}
    id="schedule-modal"
    class="modal modal-open"
    role="dialog"
    aria-modal="true"
    aria-labelledby="schedule-title"
    phx-window-keydown="close_schedule"
    phx-key="Escape"
  >
    <div class="modal-box workspace-glass max-w-lg space-y-4" lang="es">
      <div class="flex items-start justify-between gap-3">
        <div>
          <h2 id="schedule-title" class="text-lg font-semibold">Agendar visita</h2>
          <p class="workspace-muted text-sm">{@lead.name} · {place(@schedule)}</p>
        </div>
        <button
          type="button"
          phx-click="close_schedule"
          class="btn btn-sm btn-ghost btn-square"
          aria-label="Cerrar"
        >
          <.icon name="hero-x-mark" class="size-5" />
        </button>
      </div>

      <.link
        id="schedule-manually"
        navigate={~p"/visitas/nueva?#{[interes: @schedule.id]}"}
        class="workspace-divider flex items-center gap-3 rounded-xl border p-4 transition hover:bg-base-content/5"
      >
        <.icon name="hero-calendar-days" class="size-6 shrink-0" />
        <span>
          <span class="block font-semibold">Elegir yo la fecha</span>
          <span class="workspace-muted text-sm">
            Agenda la visita en un hueco libre o a la hora que acordéis.
          </span>
        </span>
      </.link>

      <div class="workspace-divider space-y-3 rounded-xl border p-4">
        <div class="flex items-center gap-3">
          <.icon name="hero-paper-airplane" class="size-6 shrink-0" />
          <span>
            <span class="block font-semibold">Enviar enlace de reserva</span>
            <span class="workspace-muted text-sm">
              {@lead.name} elige uno de tus {@free_slot_count} huecos libres y tú apruebas la visita.
            </span>
          </span>
        </div>
        <p :if={@free_slot_count == 0} class="text-warning text-sm">
          No tienes huecos libres.
          <.link navigate={~p"/visitas/disponibilidad"} class="link">
            Marca tu disponibilidad
          </.link>
          antes de enviar el enlace.
        </p>
        <%= if @booking_url do %>
          <label for="booking-url" class="sr-only">Enlace de reserva</label>
          <input
            id="booking-url"
            type="text"
            readonly
            value={@booking_url}
            class="input input-sm w-full"
          />
          <div class="flex flex-wrap gap-2">
            <a
              id="send-booking-whatsapp"
              href={whatsapp_url(@lead, @schedule, @booking_url)}
              target="_blank"
              rel="noopener noreferrer"
              class="btn workspace-primary btn-sm rounded-lg"
            >
              Enviar por WhatsApp
            </a>
            <button
              id="copy-booking-url"
              type="button"
              phx-click={JS.dispatch("phx:copy", to: "#booking-url")}
              class="btn btn-ghost btn-sm rounded-lg"
            >
              <.icon name="hero-clipboard" class="size-4" /> Copiar
            </button>
            <button
              id="revoke-booking-link"
              type="button"
              phx-click="revoke_booking_link"
              class="btn btn-ghost btn-sm text-error ms-auto rounded-lg"
            >
              Revocar
            </button>
          </div>
          <p class="workspace-muted text-xs">Caduca en 7 días. Generar otro revoca este.</p>
        <% else %>
          <button
            id="create-booking-link"
            type="button"
            phx-click="create_booking_link"
            disabled={@free_slot_count == 0}
            class="btn workspace-primary btn-sm rounded-lg"
          >
            Generar enlace
          </button>
        <% end %>
      </div>
    </div>
    <div class="modal-backdrop" phx-click="close_schedule"></div>
  </div>
</Layouts.app>
