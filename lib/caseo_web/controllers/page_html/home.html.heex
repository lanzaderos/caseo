<Layouts.app flash={@flash} current_scope={@current_scope} wide>
  <section
    id="caseo-landing"
    lang="es"
    aria-labelledby="landing-title"
  >
    <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_1fr] lg:gap-16">
      <div>
        <p class="mb-5 flex items-center gap-2 text-sm font-semibold text-base-content/80">
          <.icon name="hero-home" class="size-5" /> Para caseros particulares
        </p>
        <h1
          id="landing-title"
          class="max-w-[14ch] text-balance text-4xl leading-[1.04] font-semibold tracking-[-0.06em] sm:text-6xl xl:text-7xl"
        >
          Tus alquileres, en un solo lugar
        </h1>
        <p class="mt-6 max-w-md text-pretty text-lg leading-relaxed text-base-content/80">
          Caseo está pensado para propietarios con pocas viviendas, desde la primera candidatura
          hasta el seguimiento del alquiler.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <%= if @current_scope do %>
            <.link
              id="landing-settings"
              href={~p"/users/settings"}
              class="btn btn-neutral min-h-12 rounded-full px-6"
            >
              Ajustes de la cuenta <.icon name="hero-arrow-right" class="size-4" />
            </.link>
          <% else %>
            <.link
              id="landing-register"
              href={~p"/users/register"}
              class="btn btn-neutral min-h-12 rounded-full px-6"
            >
              Crear cuenta <.icon name="hero-arrow-right" class="size-4" />
            </.link>
            <.link
              id="landing-login"
              href={~p"/users/log-in"}
              class="btn btn-ghost landing-glass-panel min-h-12 rounded-full px-6"
            >
              Iniciar sesión
            </.link>
          <% end %>
        </div>
      </div>

      <section aria-labelledby="landing-roadmap-title">
        <h2 id="landing-roadmap-title" class="text-lg font-semibold">
          Funciones en desarrollo
        </h2>
        <ul class="mt-3 divide-y divide-base-content/15">
          <li class="grid grid-cols-[auto_1fr] items-start gap-3 py-4">
            <span class="grid size-10 place-items-center rounded-xl border border-base-100/80 bg-base-100/70">
              <.icon name="hero-clipboard-document-list" class="size-5" />
            </span>
            <div>
              <h3 class="font-semibold">Candidaturas por inmueble</h3>
              <p class="mt-1 text-sm leading-relaxed text-base-content/80">
                Comparte un cuestionario y compara las respuestas en un mismo sitio.
              </p>
            </div>
          </li>
          <li class="grid grid-cols-[auto_1fr] items-start gap-3 py-4">
            <span class="grid size-10 place-items-center rounded-xl border border-base-100/80 bg-base-100/70">
              <.icon name="hero-calendar-days" class="size-5" />
            </span>
            <div>
              <h3 class="font-semibold">Visitas y documentación</h3>
              <p class="mt-1 text-sm leading-relaxed text-base-content/80">
                Organiza visitas y solicita documentación mediante un enlace privado.
              </p>
            </div>
          </li>
          <li class="grid grid-cols-[auto_1fr] items-start gap-3 py-4">
            <span class="grid size-10 place-items-center rounded-xl border border-base-100/80 bg-base-100/70">
              <.icon name="hero-key" class="size-5" />
            </span>
            <div>
              <h3 class="font-semibold">Seguimiento del alquiler</h3>
              <p class="mt-1 text-sm leading-relaxed text-base-content/80">
                Consulta contratos, renovaciones e incidencias por vivienda.
              </p>
            </div>
          </li>
        </ul>
      </section>
    </div>
  </section>
</Layouts.app>
