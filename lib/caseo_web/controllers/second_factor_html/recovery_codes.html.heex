<Layouts.app flash={@flash} current_scope={@current_scope}>
  <section class="mx-auto max-w-xl space-y-6">
    <.header>Save your recovery codes</.header>
    <p>
      Two-factor authentication is active. Save these codes somewhere safe now. They are shown
      only once. Each code can complete one sign-in if you lose access to your authenticator.
    </p>
    <ul id="recovery-codes" class="grid gap-2 rounded-lg bg-base-200 p-4 sm:grid-cols-2">
      <li :for={code <- @codes} class="font-mono text-sm">{code}</li>
    </ul>
    <.link href={~p"/users/log-in"} class="btn btn-neutral">Continue to sign-in</.link>
  </section>
</Layouts.app>
